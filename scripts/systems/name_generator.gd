]

const FINGERPRINT_CHARS: String = "0123456789ABCDEF"

static func random_first_name(gender: Enums.Gender) -> String:
	if gender == Enums.Gender.MALE:
		return MALE_FIRST_NAMES[randi() % MALE_FIRST_NAMES.size()]
	return FEMALE_FIRST_NAMES[randi() % FEMALE_FIRST_NAMES.size()]

## Фамилия из гендерного пула ИЛИ общего несклоняемого — единым случайным
## выбором, так что несклоняемые фамилии естественно реже выпадают (их
## меньше), а не одинаково часто с обычными.
static func random_last_name(gender: Enums.Gender) -> String:
	var gendered: Array[String] = MALE_SURNAMES if gender == Enums.Gender.MALE else FEMALE_SURNAMES
	var pool: Array[String] = gendered + UNISEX_SURNAMES
	return pool[randi() % pool.size()]

## Генерирует имя+фамилию, которых точно ещё нет среди already_used (полное
## имя "Имя Фамилия" -> true). Мутирует already_used, добавляя туда результат.
static func generate_unique_full_name(gender: Enums.Gender, already_used: Dictionary) -> Dictionary:
	var first_name := ""
	var last_name := ""
	var attempts := 0
	# Пространство комбинаций (300 имён × ~390 фамилий) на порядки больше
	# размера города, так что коллизия — редкость; ограничение попыток — просто
	# защита от теоретического зацикливания, а не ожидаемый сценарий.
	while attempts < 200:
		first_name = random_first_name(gender)
		last_name = random_last_name(gender)
		var full_name := "%s %s" % [first_name, last_name]
		if not already_used.has(full_name):
			already_used[full_name] = true
			return {"first_name": first_name, "last_name": last_name}
		attempts += 1
	# Пул исчерпан (не должно происходить при разумном размере города) —
	# возвращаем последний вариант как есть, дубликат лучше зависания.
	already_used["%s %s" % [first_name, last_name]] = true
	return {"first_name": first_name, "last_name": last_name}

static func random_fingerprint() -> String:
	var s := ""
	for i in range(16):
		s += FINGERPRINT_CHARS[randi() % FINGERPRINT_CHARS.length()]
	return s
